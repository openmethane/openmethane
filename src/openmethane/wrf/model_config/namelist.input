! Model configuration for WRF: everything in namelist.input except the domain
! geometry and the run times, which namelists.py sets for each run.
!
! Write each setting once. Settings WRF takes per domain are repeated for every
! domain in the run (PER_DOMAIN in namelists.py), so a value here applies to
! all domains. Ported from setup-wrf 0.9.2's domains/<name>/namelist.wrf, which
! was the same for aust10km and au-test apart from geometry.

&time_control
    run_days = 0
    run_hours = 0
    run_minutes = 0
    run_seconds = 0
    interval_seconds = 21600
    input_from_file = .true.
    ! Output every 5 minutes, an hour per file: averaging makes each file one
    ! hourly mean
    history_interval = 5
    frames_per_outfile = 12
    restart = .false.
    iofields_filename = 'add_remove_var.txt'
    ignore_iofields_warning = .true.
    restart_interval = 5000
    io_form_history = 2
    io_form_restart = 2
    io_form_input = 2
    io_form_boundary = 2
    io_form_auxinput2 = 2
    auxinput1_inname = 'met_em.d<domain>.<date>'
    ! Sea surface temperature from wrflowinp, updated every 6 hours
    auxinput4_inname = 'wrflowinp_d<domain>'
    io_form_auxinput4 = 2
    auxinput4_interval = 360
    ! Output is uncompressed, because averaging reads it straight back
    use_netcdf_classic = .true.
    debug_level = 0
/

&domains
    time_step = 30
    time_step_fract_num = 0
    time_step_fract_den = 1
    s_vert = 1
    e_vert = 33
    feedback = 0
    smooth_option = 1
/

&physics
    mp_physics = 10
    ra_lw_physics = 4
    ra_sw_physics = 4
    radt = 30
    sf_sfclay_physics = 2
    sf_surface_physics = 2
    bl_pbl_physics = 2
    bldt = 0
    cu_physics = 5
    cudt = 5
    cu_diag = 0
    isfflx = 1
    ifsnow = 1
    icloud = 1
    surface_input_source = 1
    num_soil_layers = 4
    sf_urban_physics = 1
    sst_update = 1
    sst_skin = 1
    progn = 1
    num_land_cat = 24
/

&fdda
/

&dynamics
    w_damping = 0
    diff_opt = 1
    km_opt = 4
    diff_6th_opt = 0
    diff_6th_factor = 0.12
    base_temp = 290.0
    damp_opt = 0
    zdamp = 5000.0
    dampcoef = 0.2
    khdif = 0
    kvdif = 0
    non_hydrostatic = .true.
    moist_adv_opt = 2
    scalar_adv_opt = 2
/

&bdy_control
    spec_bdy_width = 5
    spec_zone = 1
    relax_zone = 4
    periodic_x = .false.
    symmetric_xs = .false.
    symmetric_xe = .false.
    open_xs = .false.
    open_xe = .false.
    periodic_y = .false.
    symmetric_ys = .false.
    symmetric_ye = .false.
    open_ys = .false.
    open_ye = .false.
/

&grib2
/

&namelist_quilt
    nio_tasks_per_group = 0
    nio_groups = 1
/
