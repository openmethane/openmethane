# NCI/Gadi example configuration — provided as-is, no longer officially supported.
# Copy to the repository root to use, e.g. `cp examples/nci/.env.nci .`

START_DATE=2022-12-07
END_DATE=2022-12-07

DOMAIN_NAME="aust10km"
DOMAIN_VERSION="v1"

STORE_PATH="${HOME}/scratch/openmethane"
MET_DIR="${STORE_PATH}/mcip"
CTM_DIR="${STORE_PATH}/cmaq"
WRF_DIR="${STORE_PATH}/wrf/${DOMAIN_NAME}"
GEO_DIR="${STORE_PATH}/domains/${DOMAIN_NAME}/${DOMAIN_VERSION}"
CAMS_FILE="${STORE_PATH}/cams/cams_eac4_methane_${START_DATE}-${END_DATE}.nc"

DOMAIN_MCIP_SUFFIX="${DOMAIN_NAME}_${DOMAIN_VERSION}"

PRIOR_FILE="${STORE_PATH}/prior/outputs/prior-emissions.nc"
ICON_FILE="${CTM_DIR}/<YYYY-MM-DD>/d01/ICON.d01.${DOMAIN_MCIP_SUFFIX}.CH4only.nc"
BCON_FILE="${CTM_DIR}/<YYYY-MM-DD>/d01/BCON.d01.${DOMAIN_MCIP_SUFFIX}.CH4only.nc"

NUM_PROC_COLS=8
NUM_PROC_ROWS=12
USE_JOBFS=true

# Set CMAQ_BIN to the directory holding your CMAQ-Adjoint builds.
CMAQ_BIN="${CMAQ_BIN:-$HOME/cmaq_adjoint}"
ADJOINT_FWD=/opt/cmaq/bin/ADJOINT_FWD
ADJOINT_BWD=/opt/cmaq/bin/ADJOINT_BWD
