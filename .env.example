# Use the `.env.${TARGET}` file to set the environment variables for the target.
TARGET=docker

# Login information for the Copernicus ADS api
CDSAPI_KEY=
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api

# DISABLE_CORRECT_BIAS_BY_REGION turns off regional bias correction.
# - if "true" the entire domain is used to calculate the bias.
# - if "false" (the default) the bias is calculated only from the spatial
#   region sampled by observations.
DISABLE_CORRECT_BIAS_BY_REGION=false
