&share
    wrf_core = 'ARW'
    max_dom = 1
    start_date = '2022-12-06_12:00:00'
    end_date = '2022-12-08_00:00:00'
    interval_seconds = 21600
    io_form_geogrid = 2
    debug_level = 0
/

&geogrid
    parent_id = 1
    parent_grid_ratio = 1
    i_parent_start = 1
    j_parent_start = 1
    e_we = 467
    e_sn = 443
    geog_data_res = 'usgs_10m+default'
    dx = 10000
    dy = 10000
    map_proj = 'lambert'
    ref_lat = -27.644
    ref_lon = 133.302
    truelat1 = -15.0
    truelat2 = -40.0
    stand_lon = 133.302
    ref_x = 233.5
    ref_y = 221.5
/

&ungrib
    out_format = 'WPS'
    prefix = 'ERA'
/

&metgrid
    fg_name = 'ERA', 'SST'
    io_form_metgrid = 2
/